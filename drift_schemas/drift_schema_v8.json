    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL DEFAULT '', \"notes\" TEXT NOT NULL DEFAULT '', \"priority\" TEXT NOT NULL DEFAULT '', \"due_at\" INTEGER NULL, \"due_has_time\" INTEGER NOT NULL DEFAULT 0, \"planned_at\" INTEGER NULL, \"planned_minutes\" INTEGER NULL, \"done_at\" INTEGER NULL, \"rrule\" TEXT NOT NULL DEFAULT '', \"remind_minutes\" INTEGER NULL, \"sort_key\" TEXT NOT NULL DEFAULT '', \"deleted_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"events\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL DEFAULT '', \"notes\" TEXT NOT NULL DEFAULT '', \"start_at\" INTEGER NOT NULL DEFAULT 0, \"end_at\" INTEGER NOT NULL DEFAULT 0, \"all_day\" INTEGER NOT NULL DEFAULT 0, \"rrule\" TEXT NOT NULL DEFAULT '', \"remind_minutes\" INTEGER NULL, \"color\" TEXT NOT NULL DEFAULT '', \"deleted_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
