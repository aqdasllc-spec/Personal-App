  "fixed_sql": [
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL DEFAULT '', \"notes\" TEXT NOT NULL DEFAULT '', \"priority\" TEXT NOT NULL DEFAULT '', \"due_at\" INTEGER NULL, \"done_at\" INTEGER NULL, \"sort_key\" TEXT NOT NULL DEFAULT '', \"deleted_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "field_meta",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"field_meta\" (\"tbl\" TEXT NOT NULL, \"row_id\" TEXT NOT NULL, \"field\" TEXT NOT NULL, \"hlc\" TEXT NOT NULL, PRIMARY KEY (\"tbl\", \"row_id\", \"field\"));"
        }
      ]
    },
    {
      "name": "sync_outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_outbox\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"tbl\" TEXT NOT NULL, \"row_id\" TEXT NOT NULL, \"field\" TEXT NOT NULL, \"value_json\" TEXT NULL, \"hlc\" TEXT NOT NULL, \"base_hlc\" TEXT NULL, \"change_id\" TEXT NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"last_error\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "sync_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_state\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "local_conflicts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_conflicts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"server_id\" INTEGER NULL UNIQUE, \"tbl\" TEXT NOT NULL, \"row_id\" TEXT NOT NULL, \"field\" TEXT NOT NULL, \"lost_value_json\" TEXT NULL, \"lost_hlc\" TEXT NOT NULL, \"winner_hlc\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"resolved_at\" INTEGER NULL);"
        }
      ]
    }
